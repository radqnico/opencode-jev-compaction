# syntax: docker/dockerfile:1
# Generic v2 image: host-provided OpenCode v2 binary + node runtime.
# The v2 binary is NOT published on GitHub/npm (CachyOS package only),
# so the host copies /usr/bin/opencode into the build context.
# Build from the repo root:
#   mkdir -p /tmp/ocv2ctx && cp /usr/bin/opencode /tmp/ocv2ctx/opencode-v2
#   docker build -f docker/Dockerfile.v2 --build-context v2bin=/tmp/ocv2ctx -t jev-v2:latest .
ARG NODE_VERSION=22-bookworm-slim
FROM node:${NODE_VERSION} AS base
ENV DEBIAN_FRONTEND=noninteractive

FROM base AS test
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git curl jq ripgrep && rm -rf /var/lib/apt/lists/*
# Host v2 binary, injected at build time (see header). Named by build context.
COPY --from=v2bin /opencode-v2 /opt/opencode/opencode
RUN chmod +x /opt/opencode/opencode && /opt/opencode/opencode --version
COPY --from=v2bin /opencode-version.txt /tmp/opencode-version.txt
ENV PATH="/opt/opencode:${PATH}"
# Isolated HOME so the container behaves like a first-time install:
# fresh ~/.config/opencode, fresh plugin cache, no host credentials.
ENV HOME=/home/tester
RUN useradd -m -s /bin/bash tester && mkdir -p /workspace/plugin /home/tester/.config/opencode && chown -R tester:tester /home/tester /workspace
WORKDIR /workspace/plugin
# Install plugin deps first for a stable layer; source is mounted at runtime.
COPY --chown=tester:tester package.json package-lock.json* ./
USER tester
RUN npm install --no-audit --no-fund 2>&1 | tail -n 3
# Default command runs the full harness (overridable for interactive use).
COPY --chown=tester:tester docker/entrypoint.sh /usr/local/bin/harness.sh
ENTRYPOINT ["/usr/local/bin/harness.sh"]
